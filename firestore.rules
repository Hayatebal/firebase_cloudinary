rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Shared inventory: any authenticated user can read and edit all items.
    // Item fields: name (string, 1-100 chars), quantity (integer, 0-1,000,000),
    // image_url (empty or HTTPS Cloudinary URL, at most 2,048 chars).
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function uidUnchanged() {
      return !('uid' in request.resource.data)
        || request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return !('uid' in request.resource.data)
        || request.resource.data.uid == resource.data.uid;
    }

    function hasRequiredFields(data, fields) {
      return data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(data, fields) {
      return data.keys().hasOnly(fields);
    }

    function isValidImageUrl(url) {
      return url is string
        && url.size() <= 2048
        && (url == '' || url.matches('^https://res[.]cloudinary[.]com/.*$'));
    }

    function isValidItem(data) {
      return data is map
        && hasRequiredFields(data, ['name', 'quantity', 'image_url'])
        && hasOnlyAllowedFields(data, ['name', 'quantity', 'image_url'])
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 100
        && data.quantity is int
        && data.quantity >= 0
        && data.quantity <= 1000000
        && isValidImageUrl(data.image_url);
    }

    match /items/{itemId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated()
        && isValidItem(request.resource.data);
      allow delete: if isAuthenticated();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
